generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 0. AUTENTIKASI & PENGGUNA (USERS & ROLES)
// ------------------------------------------------------

enum Role {
  WAREHOUSE_MANAGER
  STAFF
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String // Hashed password
  role      Role     @default(STAFF)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi Audit Trail Transaction
  movements StockMovement[]

  createdInbounds Inbound[]       @relation("InboundCreator")
  approvedInbounds Inbound[]      @relation("InboundApprover")

  @@map("users")
}

// ------------------------------------------------------
// 1. MASTER DATA: PRODUK & PEMASOK
// ------------------------------------------------------

model Supplier {
  id        String         @id @default(uuid())
  name      String
  code      String         @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  batches   ProductBatch[]
  inbounds  Inbound[]

  @@map("suppliers")
}

model Product {
  id            String         @id @default(uuid())
  sku           String         @unique // e.g. SKU-BEV-001
  name          String
  description   String?
  category      String
  unit          String         @default("pcs") // pcs, box, kg, liter
  minStockAlert Int            @default(10) // Batas minimum alert re-stock
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  batches       ProductBatch[]
  inboundItems  InboundItem[]

  @@map("products")
}

// ------------------------------------------------------
// 2. STRUKTUR LOKASI & GUDANG (MULTI-WAREHOUSE)
// ------------------------------------------------------

model Warehouse {
  id        String     @id @default(uuid())
  code      String     @unique // e.g. WAREHOUSE-JKT-01
  name      String
  city      String
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]

  @@map("warehouses")
}

model Location {
  id           String    @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  aisleRackBin String // e.g. "Rak-A-02-B"
  code         String    // Barcode/QR Code unik rak
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stocks        InventoryStock[]
  movementsFrom StockMovement[]  @relation("FromLocation")
  movementsTo   StockMovement[]  @relation("ToLocation")
  inboundItems  InboundItem[]

  @@unique([warehouseId, code])
  @@map("locations")
}

// ------------------------------------------------------
// 3. BATCH & MANAJEMEN STOK (FEFO/FIFO)
// ------------------------------------------------------

model ProductBatch {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  batchNumber      String // Nomor Batch dari manufaktur
  manufacturedDate DateTime?
  expiredAt        DateTime? // Krusial untuk algoritma FEFO
  createdAt        DateTime  @default(now())

  stocks    InventoryStock[]
  movements StockMovement[]

  @@index([expiredAt]) // Indexing untuk mempercepat query FEFO
  @@map("product_batches")
}

model InventoryStock {
  id             String       @id @default(uuid())
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productBatchId String
  productBatch   ProductBatch @relation(fields: [productBatchId], references: [id], onDelete: Cascade)
  quantity       Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([locationId, productBatchId]) // 1 batch hanya punya 1 record stok di 1 lokasi rak
  @@map("inventory_stocks")
}

// ------------------------------------------------------
// 4. AUDIT TRAIL & PERGERAKAN BARANG (IMMUTABLE LOGS)
// ------------------------------------------------------

enum MovementType {
  INBOUND // Penerimaan barang dari Supplier
  OUTBOUND // Pengeluaran barang ke Konsumen
  TRANSFER // Pemindahan antar Rak / Gudang
  ADJUSTMENT // Koreksi stok manual (misal barang rusak/hilang)
}

model StockMovement {
  id              String       @id @default(uuid())
  referenceNumber String // e.g. TRX-INB-20261008-001
  type            MovementType
  productBatchId  String
  productBatch    ProductBatch @relation(fields: [productBatchId], references: [id], onDelete: Cascade)

  fromLocationId String?
  fromLocation   Location? @relation("FromLocation", fields: [fromLocationId], references: [id])

  toLocationId String?
  toLocation   Location? @relation("ToLocation", fields: [toLocationId], references: [id])

  quantity Int
  notes    String?

  // Relasi Audit Trail Pengguna
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("stock_movements")
}

// ------------------------------------------------------
// 5. PENERIMAAN BARANG (INBOUND & APPROVAL)
// ------------------------------------------------------

enum InboundStatus {
  PENDING
  APPROVED
  REJECTED
}

model Inbound {
  id              String        @id @default(uuid())
  referenceNumber String        @unique // e.g. PO-2026-001
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status          InboundStatus @default(PENDING)
  notes           String?

  // Informasi Pembuat (Staff)
  createdById     String?
  creator         User?         @relation("InboundCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Informasi Penyetuju (Manager / Admin)
  approvedById    String?
  approver        User?         @relation("InboundApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InboundItem[]

  @@map("inbound_transactions")
}

model InboundItem {
  id             String       @id @default(uuid())
  inboundId      String
  inbound        Inbound      @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batchNumber    String
  quantity       Int
  expiredAt      DateTime?

  @@map("inbound_items")
}
